---
import { BookOpen, Heart, HeartPulse, House, NotebookPen, Wallet } from 'lucide-react';

interface Props { activePath: string }
const { activePath } = Astro.props;
const items = [
  { href: '/', label: '成长看板', short: '看板', icon: House, match: (path: string) => path === '/' },
  { href: '/health', label: '保健档案', short: '保健', icon: HeartPulse, match: (path: string) => path.startsWith('/health') },
  { href: '/ledger', label: '鱼蛋小账本', short: '账本', icon: Wallet, match: (path: string) => path.startsWith('/ledger') },
  { href: '/blog', label: '成长日志', short: '日志', icon: BookOpen, match: (path: string) => path.startsWith('/blog') },
  { href: '/about', label: '关于小站', short: '关于', icon: NotebookPen, match: (path: string) => path.startsWith('/about') },
];
---

<aside class="site-sidebar">
  <a href="/" class="site-brand" aria-label="鱼蛋看板首页">
    <img src="/apple-home-logo.png" width="44" height="44" alt="" />
    <span><strong>鱼蛋的小世界<span class="brand-dot">.</span></strong><small>A LITTLE LIFE, A LOT OF LOVE</small></span>
  </a>
  <div class="sidebar-section-label">日常 · 慢慢记录</div>
  <nav aria-label="主导航" class="sidebar-links">
    {items.map((item) => {
      const Icon = item.icon;
      const active = item.match(activePath);
      return <a href={item.href} aria-current={active ? 'page' : undefined} class:list={['sidebar-link', { 'is-active': active }]}>
        <Icon size={19} strokeWidth={1.7} /><span>{item.label}</span><span class="nav-active-dot" />
      </a>;
    })}
  </nav>
  <div class="sidebar-bottom">
    <div class="sidebar-note">
      <svg width="72" height="76" viewBox="0 0 72 76" fill="none" aria-hidden="true">
        <path d="M37 65V30M37 48C22 47 18 39 20 30C33 30 38 36 37 48ZM37 38C51 38 57 31 54 22C43 23 37 29 37 38Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M26 64H49M24 69H51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="22" cy="14" r="3" fill="#d5af70" /><path d="m55 51 2 2 2-2M11 51l2-2 2 2" stroke="#d5af70" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <p>长大，是每一天的小事。</p>
      <span>把平凡的日子，慢慢收藏。</span>
    </div>
    <div class="sidebar-signature"><Heart size={13} strokeWidth={1.6} /><span>为鱼蛋，用心记录</span><span class="signature-dot" /></div>
  </div>
</aside>

<nav aria-label="底部导航" class="mobile-nav">
  {items.map((item) => {
    const Icon = item.icon;
    const active = item.match(activePath);
    return <a href={item.href} aria-current={active ? 'page' : undefined} class:list={['mobile-nav-link', { 'is-active': active }]}>
      <span class="mobile-nav-icon"><Icon size={21} strokeWidth={active ? 2 : 1.7} /></span><span>{item.short}</span>
    </a>;
  })}
</nav>
