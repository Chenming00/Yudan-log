<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      let reloaded = false;
      const showUpdate = (registration: ServiceWorkerRegistration) => {
        if (!registration.waiting || document.querySelector('[data-sw-update]')) return;
        const banner = document.createElement('div');
        banner.dataset.swUpdate = 'true';
        banner.className = 'fixed inset-x-4 bottom-[calc(var(--nav-height)+1rem)] z-50 flex items-center justify-between gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm text-stone-800 shadow-lg sm:left-auto sm:right-4 sm:w-[22rem]';
        banner.innerHTML = '<span>网站有新版本可用</span><button type="button" class="rounded-lg bg-stone-900 px-3 py-1.5 text-xs font-medium text-white">更新</button>';
        banner.querySelector('button')?.addEventListener('click', () => {
          registration.waiting?.postMessage({ type: 'SKIP_WAITING' });
          banner.remove();
        });
        document.body.appendChild(banner);
      };

      const register = () => navigator.serviceWorker.register('/sw.js').then((registration) => {
        showUpdate(registration);
        registration.addEventListener('updatefound', () => {
          registration.installing?.addEventListener('statechange', () => showUpdate(registration));
        });
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!reloaded) {
            reloaded = true;
            window.location.reload();
          }
        }, { once: true });
      }).catch((err) => {
        console.warn('Service Worker 注册失败:', err);
      });

      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(register, { timeout: 2000 });
      } else {
        window.setTimeout(register, 500);
      }
    }, { once: true });
  }
</script>
