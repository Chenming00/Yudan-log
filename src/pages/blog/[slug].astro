---
import { ArrowLeft, Calendar, Clock3 } from 'lucide-react';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdjacentBlogPosts, getBlogEntries, toBlogCardPost } from '../../lib/astro-blog';
import { PostActions } from '../../components/blog/post-actions';
import { TocCard } from '../../components/blog/toc-card';
import { ReadingProgress } from '../../components/blog/reading-progress';
import { AiChat } from '../../components/blog/ai-chat';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getBlogEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || process.env.BASE_URL || import.meta.env.NEXT_PUBLIC_SITE_URL || 'http://localhost:3000';
const { entry } = Astro.props;
const post = toBlogCardPost(entry);
const { Content, headings } = await render(entry);
const { previous, next } = await getAdjacentBlogPosts(post.slug);
const tocHeadings = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({
    level: heading.depth,
    text: heading.text,
    id: heading.slug,
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary,
  image: post.cover ? new URL(post.cover, siteUrl).toString() : undefined,
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: '鱼蛋宝宝',
  },
  publisher: {
    '@type': 'Organization',
    name: '鱼蛋宝宝',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', siteUrl).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.slug}`, siteUrl).toString(),
  },
};
---

<BaseLayout
  title={post.title}
  description={post.summary}
  canonical={`/blog/${post.slug}`}
  image={post.cover}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="min-h-screen bg-background">
    <ReadingProgress client:load />

    <header class="sticky top-0 z-50 glass-effect border-b border-border/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center gap-3">
        <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors p-2 -ml-2 rounded-xl hover:bg-muted/80 active:bg-muted" aria-label="返回文章列表">
          <ArrowLeft class="h-5 w-5" />
        </a>
        <div class="flex-1 min-w-0">
          <h1 class="text-sm font-semibold text-foreground truncate">{post.title}</h1>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-5 sm:px-6">
      <div class="flex gap-8 lg:gap-12">
        <article class="flex-1 min-w-0 py-6 sm:py-10" style="padding-bottom: var(--nav-height)">
          <header class="mb-8 sm:mb-10">
            <h1 class="text-[26px] sm:text-3xl lg:text-[40px] font-bold text-foreground leading-tight tracking-tight">
              {post.title}
            </h1>

            <div class="mt-4 sm:mt-5 flex flex-wrap items-center gap-3 sm:gap-5 text-xs sm:text-sm text-muted-foreground">
              {post.date && (
                <div class="flex items-center gap-1.5">
                  <Calendar class="h-4 w-4" />
                  <span>{post.date}</span>
                </div>
              )}
              <div class="flex items-center gap-1.5">
                <Clock3 class="h-4 w-4" />
              <span>{post.readingTime} 分钟阅读</span>
              </div>
            </div>

            {post.tags.length > 0 && (
              <div class="mt-3 sm:mt-4 flex flex-wrap gap-1.5 sm:gap-2">
                {post.tags.map((tag) => (
                  <span class="rounded-full bg-muted/80 px-2.5 py-1 text-xs font-medium text-muted-foreground/80 border border-border/30">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            <div class="mt-6 sm:mt-8 border-l-[3px] border-primary/40 pl-4 sm:pl-5 py-1">
              <p class="text-[11px] uppercase tracking-widest font-semibold text-primary/70 mb-2">
                摘要
              </p>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
                {post.summary}
              </p>
            </div>
          </header>

          <div class="lg:hidden mb-8">
            <TocCard headings={tocHeadings} defaultOpen={false} client:load />
          </div>

          <div class="blog-content prose prose-neutral max-w-full sm:max-w-3xl prose-headings:text-foreground prose-p:text-muted-foreground prose-li:text-muted-foreground prose-strong:text-foreground prose-a:text-primary prose-a:underline-offset-4 prose-blockquote:text-muted-foreground/80 prose-blockquote:border-primary/30 prose-code:text-primary prose-pre:bg-muted/70">
            <Content />
          </div>

          <AiChat slug={post.slug} client:visible />

          <div class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-border/40 max-w-full sm:max-w-3xl">
            <p class="text-sm font-medium text-muted-foreground mb-4">分享文章</p>
            <PostActions title={post.title} summary={post.summary} client:visible />
          </div>

          {(previous || next) && (
            <nav class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-border/40 max-w-full sm:max-w-3xl">
              <div class="grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2">
                {previous ? (
                  <a href={`/blog/${previous.slug}`} class="group p-4 sm:p-5 rounded-2xl border-2 border-border/40 hover:border-primary/30 hover:bg-muted/30 active:bg-muted/40 transition-all">
                    <p class="text-xs font-medium text-muted-foreground mb-1.5 sm:mb-2">← 上一篇</p>
                    <p class="text-sm sm:text-base font-semibold text-foreground group-hover:text-primary transition-colors line-clamp-2">{previous.title}</p>
                  </a>
                ) : <div />}
                {next ? (
                  <a href={`/blog/${next.slug}`} class="group p-4 sm:p-5 rounded-2xl border-2 border-border/40 hover:border-primary/30 hover:bg-muted/30 active:bg-muted/40 transition-all text-left sm:text-right">
                    <p class="text-xs font-medium text-muted-foreground mb-1.5 sm:mb-2">下一篇 →</p>
                    <p class="text-sm sm:text-base font-semibold text-foreground group-hover:text-primary transition-colors line-clamp-2">{next.title}</p>
                  </a>
                ) : <div />}
              </div>
            </nav>
          )}
        </article>

        {tocHeadings.length > 0 && (
          <aside class="hidden lg:block w-64 shrink-0">
            <div class="sticky top-24 pt-4">
              <TocCard headings={tocHeadings} client:load />
            </div>
          </aside>
        )}
      </div>
    </div>
  </main>
</BaseLayout>
