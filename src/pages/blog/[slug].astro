---
import { ArrowLeft, Calendar, Clock3 } from 'lucide-react';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdjacentBlogPosts, getBlogEntries, toBlogCardPost } from '../../lib/astro-blog';
import { PostActions } from '../../components/blog/post-actions';
import { TocCard } from '../../components/blog/toc-card';
import { ReadingProgress } from '../../components/blog/reading-progress';
import { AiChat } from '../../components/blog/ai-chat';
import CodeBlocks from '../../components/CodeBlocks.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getBlogEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || process.env.BASE_URL || import.meta.env.NEXT_PUBLIC_SITE_URL || 'http://localhost:3000';
const { entry } = Astro.props;
const post = toBlogCardPost(entry);
const { Content, headings } = await render(entry);
const { previous, next } = await getAdjacentBlogPosts(post.slug);
const tocHeadings = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({
    level: heading.depth,
    text: heading.text,
    id: heading.slug,
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary,
  image: post.cover ? new URL(post.cover, siteUrl).toString() : undefined,
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: '鱼蛋宝宝',
  },
  publisher: {
    '@type': 'Organization',
    name: '鱼蛋宝宝',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', siteUrl).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.slug}`, siteUrl).toString(),
  },
};
---

<BaseLayout
  title={post.title}
  description={post.summary}
  canonical={`/blog/${post.slug}`}
  image={post.cover}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="page-shell">
    <ReadingProgress client:load />
    <CodeBlocks />
    <a href="/blog" class="mb-7 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-primary" aria-label="返回文章列表">
      <ArrowLeft className="h-4 w-4" />返回成长日志
    </a>

    <div class="grid items-start gap-7 xl:grid-cols-[minmax(0,1fr)_230px]">
      <article class="min-w-0 overflow-hidden rounded-[24px] border border-border bg-card px-5 py-7 sm:px-9 sm:py-10">
        <header class="mb-9 border-b border-border pb-8">
          <p class="page-eyebrow">A PAGE OF OUR LIFE</p>
          <h1 class="mt-4 text-[27px] font-semibold leading-[1.45] tracking-tight text-foreground sm:text-4xl">{post.title}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground">
            {post.date && <span class="inline-flex items-center gap-1.5"><Calendar className="h-3.5 w-3.5" /><time datetime={post.date}>{post.date.replace(/-/g, '.')}</time></span>}
            <span class="inline-flex items-center gap-1.5"><Clock3 className="h-3.5 w-3.5" />{post.readingTime} 分钟阅读</span>
          </div>
          {post.tags.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{post.tags.map((tag) => <span class="rounded-full bg-secondary px-3 py-1 text-[11px] text-primary">{tag}</span>)}</div>}
          <div class="mt-7 rounded-r-xl border-l-2 border-primary/50 bg-secondary/60 px-4 py-4 sm:px-5">
            <p class="mb-2 text-[10px] font-semibold tracking-[0.16em] text-primary">写在前面</p>
            <p class="text-sm leading-7 text-muted-foreground">{post.summary}</p>
          </div>
        </header>

        <div class="mb-8 xl:hidden"><TocCard headings={tocHeadings} defaultOpen={false} client:load /></div>
        <div class="blog-content prose prose-neutral max-w-none text-[15px] leading-8 prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground/85 prose-li:text-foreground/85 prose-strong:text-foreground prose-a:text-primary prose-a:decoration-primary/40 prose-a:underline-offset-4 prose-blockquote:border-primary/30 prose-blockquote:text-muted-foreground prose-code:text-primary prose-pre:bg-secondary sm:text-base">
          <Content />
        </div>

        <AiChat slug={post.slug} client:visible />
        <section class="mt-9 flex flex-col justify-between gap-4 border-t border-border pt-7 sm:flex-row sm:items-center" aria-label="分享文章">
          <div><p class="text-sm font-medium text-foreground">把这一页，分享给在意的人</p><p class="mt-1 text-xs text-muted-foreground">也可以复制链接，留待以后再读。</p></div>
          <PostActions title={post.title} summary={post.summary} client:visible />
        </section>
      </article>

      <aside class="sticky top-[calc(var(--shell-header-height)+1.5rem)] hidden min-w-0 xl:block">
        <div class="space-y-5">
          <div class="rounded-2xl border border-border bg-[#eee7d9]/55 px-5 py-6">
            <p class="text-[10px] tracking-[0.16em] text-[#766346]">THE FAMILY JOURNAL</p>
            <p class="mt-4 font-serif text-lg leading-8 text-foreground">平凡日常里的<br />每一个小小瞬间。</p>
            <a href="/blog" class="mt-5 inline-flex items-center gap-2 text-xs text-primary">翻看更多记录 <span aria-hidden="true">↗</span></a>
          </div>
          <TocCard headings={tocHeadings} client:load />
        </div>
      </aside>
    </div>

    {(previous || next) && <nav class="mt-7 grid gap-4 sm:grid-cols-2 xl:mr-[258px]" aria-label="相邻文章">
      {previous ? <a href={`/blog/${previous.slug}`} class="group rounded-2xl border border-border bg-card p-5 transition-colors hover:border-primary/40"><p class="mb-2 text-xs text-muted-foreground">← 上一篇</p><p class="text-sm font-medium leading-6 text-foreground transition-colors group-hover:text-primary">{previous.title}</p></a> : <div />}
      {next ? <a href={`/blog/${next.slug}`} class="group rounded-2xl border border-border bg-card p-5 transition-colors hover:border-primary/40 sm:text-right"><p class="mb-2 text-xs text-muted-foreground">下一篇 →</p><p class="text-sm font-medium leading-6 text-foreground transition-colors group-hover:text-primary">{next.title}</p></a> : <div />}
    </nav>}
  </main>
</BaseLayout>
