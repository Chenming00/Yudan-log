---
import {
  Bot,
  BookOpenText,
  CheckCircle2,
  Code2,
  GitBranch,
  GitCommitHorizontal,
  GitPullRequest,
  HeartPulse,
  NotebookPen,
  Rocket,
  Search,
  ShieldCheck,
  WalletCards,
} from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';

const repoFacts = [
  { label: 'framework', value: 'Astro + React' },
  { label: 'deploy', value: 'Vercel' },
  { label: 'data', value: 'Supabase' },
  { label: 'domain', value: 'cost.ykn.cm' },
  { label: 'status', value: 'production' },
];

const modules = [
  {
    name: 'dashboard',
    title: '疫苗与体重看板',
    body: '按宝宝出生日期生成建议接种日期，记录实际接种日期和体重变化，手机与电脑都能清楚查看。',
    icon: HeartPulse,
  },
  {
    name: 'ledger',
    title: '鱼蛋小账本',
    body: '给家里日常花费用的轻量账本：记一笔、看本月、翻历史、按分类复盘，并保留 API Key 写入方式。',
    icon: WalletCards,
  },
  {
    name: 'blog',
    title: '成长 Log',
    body: '用 Markdown 留下鱼蛋成长、家庭日常和爸爸一路折腾这个站点的记录。',
    icon: BookOpenText,
  },
];

const commits = [
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'add key-authenticated vaccine and weight APIs',
    body: '看板增加了面向自动化的 API：可以用现有 API Key 读取云端记录、按日期写入体重，也可以登记某一剂疫苗的实际接种日期。重复请求会更新原记录，并发写入则会自动重试，方便之后接入快捷指令或其他工具。',
    icon: Code2,
  },
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'launch vaccine and weight dashboard',
    body: '首页正式变成鱼蛋的疫苗与体重看板。疫苗按常规接种时间排序，以中国国家免疫规划为主，参考美国 CDC 儿童程序补充自费项目。页面只保留最常用的建议日期、实际日期和体重记录，并完成手机与 PC 自适应。',
    icon: HeartPulse,
  },
  {
    date: '2026-08-21',
    type: 'security',
    title: 'secure cloud data with GitHub OAuth and RLS',
    body: '看板和账本统一接入 Supabase GitHub OAuth，只允许指定 GitHub 邮箱写入。账本 API 同时保留原有 API Key，便于 Telegram 和其他接口继续记账。Supabase RLS 收紧为公开只读、服务端受控写入，管理函数的公开执行权也一并撤回。',
    icon: ShieldCheck,
  },
  {
    date: '2026-08-21',
    type: 'deploy',
    title: 'publish the dashboard at cost.ykn.cm',
    body: '代码通过 GitHub PR 合并到 main，Vercel 负责预览与生产发布，Supabase 保存账本、疫苗和体重数据。GitHub OAuth 回跳、站点基础地址和正式域名全部统一到 cost.ykn.cm。',
    icon: Rocket,
  },
  {
    date: '2026-06-16',
    type: 'perf',
    title: 'optimize Astro structure and ledger performance',
    body: '从 GitHub 历史看，这是 Astro 迁移后的收尾优化：把底部导航和首页问候改成静态组件，账本里的重图表按需加载，也清掉不再使用的依赖，让小站更轻、更快。',
    icon: Rocket,
  },
  {
    date: '2026-06-16',
    type: 'refactor',
    title: 'migrate site from Next.js to Astro',
    body: '这是一次架构转向：页面入口迁到 Astro，内容页交给 Astro，交互区域继续用 React，部署到 Vercel 的路径也更清晰。它把这个站从实验状态整理成更稳定的形态。',
    icon: GitBranch,
  },
  {
    date: '2026-05-03',
    type: 'feat',
    title: 'build monthly ledger views and visual summaries',
    body: '小账本开始不只是记录流水，而是能复盘一个月：月度聚合、历史分页、日历热力图和数字动效陆续出现，账本的“看懂生活开销”这一面真正成型。',
    icon: WalletCards,
  },
  {
    date: '2026-04-29',
    type: 'feat',
    title: 'connect AI chat and article summaries',
    body: '这一组提交把文章总结、文章问答和账单讨论接进来。虽然中间经历过回滚和重做，但它标记了这个小站从静态记录走向“可以被追问”的阶段。',
    icon: Bot,
  },
  {
    date: '2026-04-22',
    type: 'feat',
    title: 'improve markdown reading experience',
    body: '成长日志的阅读体验在这段历史里被认真打磨：目录、阅读进度、代码复制、标题结构和文章页布局都补上了，让长文章更像一个可以长期保存和回看的地方。',
    icon: Search,
  },
  {
    date: '2026-04-21',
    type: 'feat',
    title: 'add markdown blog and PWA basics',
    body: '博客功能和 PWA 基础在这天落地，Markdown 内容、语法高亮、缓存和站点基础能力串起来，鱼蛋花费不再只是账本，也开始承载家庭记录。',
    icon: BookOpenText,
  },
  {
    date: '2026-04-21',
    type: 'feat',
    title: 'shape ledger dashboard and input workflow',
    body: '账本在这天快速长出核心工作流：搜索筛选、交易详情、编辑删除、快捷添加、分类选择、Telegram 消息解析和图表组件，逐渐从原型变成可日常使用的小工具。',
    icon: WalletCards,
  },
  {
    date: '2026-04-20',
    type: 'feat',
    title: 'initialize finance system with Telegram and Supabase',
    body: '这是 GitHub 历史里的起点：Telegram webhook、Supabase 和交易记录 API 先搭起来。后面的账本、日志、AI 功能，都是从这个最初的个人记账系统慢慢长出来的。',
    icon: GitCommitHorizontal,
  },
];

const roadmap = [
  'next: 开始填入真实接种日期',
  'next: 持续补充体重记录',
  'next: 按门诊建议校准疫苗方案',
  'next: 继续记录鱼蛋的成长日常',
];
---

<BaseLayout
  title="鱼蛋看板开发日记"
  description="记录鱼蛋看板从家庭账本到疫苗、体重与云端同步工具的主要开发变化。"
  canonical="/about"
>
  <main class="min-h-screen px-4 py-6 sm:px-6 lg:px-8" style="padding-bottom: var(--nav-height)">
    <div class="mx-auto max-w-6xl">
      <section class="pt-safe">
        <div class="grid gap-6 lg:grid-cols-[1fr_360px] lg:items-stretch">
          <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
            <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-muted-foreground">
              <GitPullRequest class="h-3.5 w-3.5 text-primary" />
              about / development-log
            </div>

            <h1 class="mt-6 text-3xl font-bold leading-tight text-foreground sm:text-4xl lg:text-5xl">
              鱼蛋看板开发日记
            </h1>
            <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground sm:text-lg">
              这是边记录生活、边写代码、边慢慢迭代出来的家庭项目。它从一个小账本出发，现在也记录鱼蛋的疫苗日期、体重变化和成长文章。这里用一份精简的 commit log，记下它一路发生过的主要变化。
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              <span class="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">father-built</span>
              <span class="rounded-full bg-expense/10 px-3 py-1.5 text-xs font-medium text-expense">family-ledger</span>
              <span class="rounded-full bg-muted px-3 py-1.5 text-xs font-medium text-muted-foreground">vaccine-tracker</span>
            </div>
          </div>

          <aside class="rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6">
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div>
                <p class="text-xs font-medium text-muted-foreground">Repository</p>
                <h2 class="mt-1 text-lg font-semibold text-foreground">Yudan-log</h2>
              </div>
              <Code2 class="h-5 w-5 text-primary" />
            </div>

            <dl class="mt-4 space-y-3">
              {repoFacts.map((fact) => (
                <div class="flex items-center justify-between gap-4 rounded-xl bg-muted/50 px-3 py-2.5">
                  <dt class="text-xs font-medium text-muted-foreground">{fact.label}</dt>
                  <dd class="text-right text-xs font-semibold text-foreground">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </div>
      </section>

      <section class="mt-8 grid gap-4 md:grid-cols-3">
        {modules.map((mod) => {
          const Icon = mod.icon;
          return (
            <article class="rounded-2xl border border-border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                  /{mod.name}
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon class="h-4.5 w-4.5" />
                </span>
              </div>
              <h2 class="mt-4 text-base font-semibold text-foreground">{mod.title}</h2>
              <p class="mt-2 text-sm leading-7 text-muted-foreground">{mod.body}</p>
            </article>
          );
        })}
      </section>

      <section class="mt-12 grid gap-8 lg:grid-cols-[260px_1fr]">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="text-sm font-medium text-primary">Commit log</p>
          <h2 class="mt-2 text-2xl font-semibold text-foreground">主要开发变化</h2>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">
            按 GitHub 提交历史倒序整理，最新改动放在最上面；不逐条罗列所有 commit，只保留对这个小站影响最大的变化。
          </p>
        </div>

        <div class="relative">
          <div class="absolute bottom-0 left-[18px] top-0 w-px bg-border" aria-hidden="true"></div>
          <div class="space-y-5">
            {commits.map((commit) => {
              const Icon = commit.icon;
              return (
                <article class="relative pl-12">
                  <span class="absolute left-0 top-5 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-primary shadow-sm">
                    <Icon class="h-4.5 w-4.5" />
                  </span>

                  <div class="rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">
                        {commit.type}
                      </span>
                      <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <GitCommitHorizontal class="h-3.5 w-3.5" />
                        <span>{commit.date}</span>
                      </div>
                    </div>
                    <h3 class="mt-3 font-mono text-sm font-semibold leading-6 text-foreground sm:text-base">
                      {commit.type}: {commit.title}
                    </h3>
                    <p class="mt-2 text-sm leading-7 text-muted-foreground">{commit.body}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="mt-12 grid gap-4 lg:grid-cols-[1fr_360px]">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <NotebookPen class="h-5 w-5" />
            </span>
            <div>
              <p class="text-sm font-medium text-primary">Note</p>
              <h2 class="text-xl font-semibold text-foreground">写给未来的鱼蛋</h2>
            </div>
          </div>
          <p class="mt-4 text-sm leading-8 text-muted-foreground sm:text-base">
            如果以后你看到这里，会发现这个网站不是一夜之间做完的。爸爸是一点点把它改出来的：有时候是为了记账更快，有时候是为了文章更好读，这次则是想把你的疫苗和体重好好记下来。工具会继续变，但记录这件事会一直留下来。
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
          <div class="flex items-center gap-2">
            <CheckCircle2 class="h-5 w-5 text-primary" />
            <h2 class="text-xl font-semibold text-foreground">Roadmap</h2>
          </div>
          <ul class="mt-4 space-y-2">
            {roadmap.map((item) => (
              <li class="rounded-xl bg-muted/60 px-3 py-2.5 font-mono text-xs leading-6 text-foreground">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
