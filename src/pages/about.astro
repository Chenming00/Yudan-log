---
import {
  ArrowRight,
  Bot,
  BookOpenText,
  CheckCircle2,
  Code2,
  ExternalLink,
  GitBranch,
  GitCommitHorizontal,
  GitPullRequest,
  HeartPulse,
  NotebookPen,
  Rocket,
  Search,
  ShieldCheck,
  WalletCards,
} from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import McpGuide from '../components/McpGuide.astro';

const repoFacts = [
  { label: 'framework', value: 'Astro + React' },
  { label: 'deploy', value: 'Vercel' },
  { label: 'data', value: 'Supabase' },
  { label: 'domain', value: 'cost.ykn.cm' },
  { label: 'status', value: 'production' },
];

const modules = [
  {
    name: 'dashboard',
    href: '/',
    tone: 'bg-sky-50 text-sky-700',
    title: '鱼蛋看板',
    body: '首页优先展示最新体重和连续趋势，并同时对照 WHO 与中国男童生长标准；未登录展示示例，授权登录后才读取真实云端记录。',
    icon: HeartPulse,
  },
  {
    name: 'health',
    href: '/health',
    tone: 'bg-emerald-50 text-emerald-700',
    title: '保健档案',
    body: '默认先进入体重档案，记录体重并查看同龄参考位置；疫苗名称、剂次和建议日期由数据库标准清单统一管理。',
    icon: ShieldCheck,
  },
  {
    name: 'ledger',
    href: '/ledger',
    tone: 'bg-amber-50 text-amber-700',
    title: '鱼蛋小账本',
    body: '给家里日常花费用的轻量账本：记一笔、看本月、翻历史、按分类复盘，并保留 API Key 写入方式。',
    icon: WalletCards,
  },
  {
    name: 'blog',
    href: '/blog',
    tone: 'bg-[#e5ebdb] text-[#49613d]',
    title: '成长 Log',
    body: '用 Markdown 留下鱼蛋成长、家庭日常和爸爸一路折腾这个站点的记录。',
    icon: BookOpenText,
  },
];

const commits = [
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'add privacy-safe guest preview and refine growth chart',
    body: '看板和保健模块取消整页登录墙：访客可以浏览明确标注的示例内容，真实体重与接种记录仍只在授权 GitHub 登录后加载和修改。体重图改为按实际数据范围缩放，修复纵轴裁切；出生日期固定为 2026 年 8 月 12 日，并为手机重新排版。',
    icon: ShieldCheck,
  },
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'compare weight with WHO and China growth standards',
    body: '保健页调整为体重优先，首页和体重档案同时显示男宝宝在 WHO 0–2 岁标准与中国 WS/T 423—2022 标准中的百分位、参考区间和中位数。对照只用于观察位置与连续趋势，并保留儿保评估提示。',
    icon: HeartPulse,
  },
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'separate health records and standardize vaccine data',
    body: '首页回归简洁看板，疫苗和体重移入独立保健模块。数据库保存浙江省杭州市 2026-08 标准清单、官方名称、别名、预防疾病和稳定计划 ID；API 写入前先匹配标准项目，只有唯一命中才记录，避免同一疫苗产生不同标签。',
    icon: ShieldCheck,
  },
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'add key-authenticated vaccine and weight APIs',
    body: '看板增加了面向自动化的 API：可以用现有 API Key 读取云端记录、按日期写入体重，也可以登记某一剂疫苗的实际接种日期。重复请求会更新原记录，并发写入则会自动重试，方便之后接入快捷指令或其他工具。',
    icon: Code2,
  },
  {
    date: '2026-08-21',
    type: 'feat',
    title: 'launch vaccine and weight dashboard',
    body: '首页正式变成鱼蛋的疫苗与体重看板。疫苗按常规接种时间排序，以中国国家免疫规划为主，参考美国 CDC 儿童程序补充自费项目。页面只保留最常用的建议日期、实际日期和体重记录，并完成手机与 PC 自适应。',
    icon: HeartPulse,
  },
  {
    date: '2026-08-21',
    type: 'security',
    title: 'secure cloud data with GitHub OAuth and RLS',
    body: '看板和账本统一接入 Supabase GitHub OAuth，只允许指定 GitHub 邮箱写入。账本 API 同时保留原有 API Key，便于 Telegram 和其他接口继续记账。Supabase RLS 收紧为公开只读、服务端受控写入，管理函数的公开执行权也一并撤回。',
    icon: ShieldCheck,
  },
  {
    date: '2026-08-21',
    type: 'deploy',
    title: 'publish the dashboard at cost.ykn.cm',
    body: '代码通过 GitHub PR 合并到 main，Vercel 负责预览与生产发布，Supabase 保存账本、疫苗和体重数据。GitHub OAuth 回跳、站点基础地址和正式域名全部统一到 cost.ykn.cm。',
    icon: Rocket,
  },
  {
    date: '2026-06-16',
    type: 'perf',
    title: 'optimize Astro structure and ledger performance',
    body: '从 GitHub 历史看，这是 Astro 迁移后的收尾优化：把底部导航和首页问候改成静态组件，账本里的重图表按需加载，也清掉不再使用的依赖，让小站更轻、更快。',
    icon: Rocket,
  },
  {
    date: '2026-06-16',
    type: 'refactor',
    title: 'migrate site from Next.js to Astro',
    body: '这是一次架构转向：页面入口迁到 Astro，内容页交给 Astro，交互区域继续用 React，部署到 Vercel 的路径也更清晰。它把这个站从实验状态整理成更稳定的形态。',
    icon: GitBranch,
  },
  {
    date: '2026-05-03',
    type: 'feat',
    title: 'build monthly ledger views and visual summaries',
    body: '小账本开始不只是记录流水，而是能复盘一个月：月度聚合、历史分页、日历热力图和数字动效陆续出现，账本的“看懂生活开销”这一面真正成型。',
    icon: WalletCards,
  },
  {
    date: '2026-04-29',
    type: 'feat',
    title: 'connect AI chat and article summaries',
    body: '这一组提交把文章总结、文章问答和账单讨论接进来。虽然中间经历过回滚和重做，但它标记了这个小站从静态记录走向“可以被追问”的阶段。',
    icon: Bot,
  },
  {
    date: '2026-04-22',
    type: 'feat',
    title: 'improve markdown reading experience',
    body: '成长日志的阅读体验在这段历史里被认真打磨：目录、阅读进度、代码复制、标题结构和文章页布局都补上了，让长文章更像一个可以长期保存和回看的地方。',
    icon: Search,
  },
  {
    date: '2026-04-21',
    type: 'feat',
    title: 'add markdown blog and PWA basics',
    body: '博客功能和 PWA 基础在这天落地，Markdown 内容、语法高亮、缓存和站点基础能力串起来，鱼蛋花费不再只是账本，也开始承载家庭记录。',
    icon: BookOpenText,
  },
  {
    date: '2026-04-21',
    type: 'feat',
    title: 'shape ledger dashboard and input workflow',
    body: '账本在这天快速长出核心工作流：搜索筛选、交易详情、编辑删除、快捷添加、分类选择、Telegram 消息解析和图表组件，逐渐从原型变成可日常使用的小工具。',
    icon: WalletCards,
  },
  {
    date: '2026-04-20',
    type: 'feat',
    title: 'initialize finance system with Telegram and Supabase',
    body: '这是 GitHub 历史里的起点：Telegram webhook、Supabase 和交易记录 API 先搭起来。后面的账本、日志、AI 功能，都是从这个最初的个人记账系统慢慢长出来的。',
    icon: GitCommitHorizontal,
  },
];

const roadmap = [
  'next: 开始填入真实接种日期',
  'next: 持续补充体重记录',
  'next: 按门诊建议校准疫苗方案',
  'next: 继续记录鱼蛋的成长日常',
];
---

<BaseLayout
  title="鱼蛋看板开发日记"
  description="鱼蛋看板 MCP 接入指南、AI 记账与健康记录工具使用说明，以及主要开发变化。"
  canonical="/about"
>
  <main class="relative min-h-screen overflow-x-hidden bg-[#f5f2eb] px-4 py-4 text-stone-900 sm:px-6 sm:py-6" style="padding-bottom: calc(var(--nav-height) + 1.5rem)">
    <div class="pointer-events-none absolute -left-32 top-40 h-80 w-80 rounded-full bg-[#dfe9d7]/70 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-32 top-[34rem] h-80 w-80 rounded-full bg-[#f3dfcb]/70 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl space-y-5 sm:space-y-6">
      <header class="flex items-center justify-between gap-4 px-1 py-1">
        <div class="flex min-w-0 items-center gap-3">
          <img src="/apple-home-logo.png" alt="鱼蛋" width="44" height="44" class="h-11 w-11 rounded-2xl object-cover shadow-sm ring-1 ring-stone-900/5" />
          <div class="min-w-0">
            <h1 class="truncate text-lg font-bold tracking-tight text-[#183c2f]">关于鱼蛋看板</h1>
            <p class="mt-0.5 text-xs text-stone-500">把生活的记录，和小站的成长放在一起</p>
          </div>
        </div>
        <a href="/" aria-label="返回鱼蛋成长看板" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/80 text-[#183c2f] shadow-sm ring-1 ring-stone-900/5 transition hover:bg-white"><ArrowRight className="h-4 w-4 rotate-180" /></a>
      </header>

      <section class="grid gap-4 lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)]">
        <div class="relative flex min-h-[320px] flex-col justify-between gap-8 overflow-hidden rounded-[28px] bg-[#183c2f] p-6 text-white shadow-[0_24px_60px_-32px_rgba(24,60,47,0.75)] sm:p-8">
          <div class="pointer-events-none absolute -right-12 -top-12 h-52 w-52 rounded-full border-[36px] border-white/5" aria-hidden="true"></div>
          <div class="relative">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium text-[#e3edc8] ring-1 ring-white/10"><GitPullRequest className="h-3.5 w-3.5" />一个爸爸慢慢写出来的家庭项目</span>
            <h2 class="mt-5 text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-5xl">生活慢慢记录，<br />小站慢慢长大。</h2>
            <p class="mt-4 max-w-xl text-sm leading-7 text-white/65">从一笔日常开销，到鱼蛋的体重、疫苗和成长文章。这里保存着一家人的生活，也记下这个小站一路发生的变化。</p>
          </div>
          <div class="relative flex flex-wrap items-center gap-3">
            <a href="#mcp" class="inline-flex h-11 items-center gap-3 rounded-2xl bg-[#d6e4a9] px-4 text-sm font-semibold text-[#183c2f] transition hover:bg-[#e3edc8]">MCP 接入指南 ↓<ArrowRight className="h-4 w-4" /></a>
            <a href="#development-log" class="inline-flex h-11 items-center gap-2 rounded-2xl bg-white/10 px-4 text-sm font-medium text-white/80 transition hover:bg-white/20">翻翻开发日记<GitCommitHorizontal className="h-4 w-4" /></a>
          </div>
        </div>

        <aside class="flex flex-col rounded-[28px] bg-[#f0cfaa] p-6 shadow-[0_18px_50px_-34px_rgba(92,58,28,0.55)] sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <div><p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#70451f]">Behind the site</p><h2 class="mt-2 text-2xl font-semibold tracking-tight text-[#3f2b1a]">Yudan-log</h2></div>
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-white/65 text-[#70451f]"><Code2 className="h-5 w-5" /></span>
          </div>
          <dl class="mt-5 divide-y divide-[#70451f]/10">
            {repoFacts.map((fact) => (
              <div class="flex items-center justify-between gap-4 py-2.5"><dt class="text-xs text-[#70451f]/70">{fact.label}</dt><dd class="text-right text-xs font-semibold text-[#3f2b1a]">{fact.value}</dd></div>
            ))}
          </dl>
          <a href="https://github.com/Chenming00/Yudan-log" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex h-11 items-center justify-between gap-3 rounded-2xl bg-white/75 px-4 text-sm font-semibold text-[#3f2b1a] transition hover:bg-white">到 GitHub 看看<ExternalLink className="h-4 w-4" /></a>
        </aside>
      </section>

      <section aria-label="小站的四个角落" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {modules.map((mod) => {
          const Icon = mod.icon;
          return (
            <a href={mod.href} class="group rounded-3xl bg-white/85 p-5 shadow-sm ring-1 ring-stone-900/5 transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-center justify-between gap-3">
                <span class:list={['grid h-10 w-10 place-items-center rounded-2xl', mod.tone]}><Icon className="h-5 w-5" /></span>
                <ArrowRight className="h-4 w-4 text-stone-300 transition group-hover:translate-x-0.5 group-hover:text-stone-600" />
              </div>
              <h2 class="mt-5 text-base font-semibold tracking-tight text-stone-950">{mod.title}</h2>
              <p class="mt-2 text-xs leading-6 text-stone-500">{mod.body}</p>
            </a>
          );
        })}
      </section>

      <McpGuide />

      <section id="development-log" class="grid scroll-mt-8 gap-5 pt-4 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-8">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#49613d]">Development journal</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-[#183c2f]">主要开发变化</h2>
          <p class="mt-3 text-sm leading-7 text-stone-500">
            按 GitHub 提交历史倒序整理，最新改动放在最上面；不逐条罗列所有 commit，只保留对这个小站影响最大的变化。
          </p>
        </div>

        <div class="relative">
          <div class="absolute bottom-0 left-[18px] top-0 w-px bg-[#cdd8c4]" aria-hidden="true"></div>
          <div class="space-y-5">
            {commits.map((commit) => {
              const Icon = commit.icon;
              return (
                <article class="relative pl-12">
                  <span class="absolute left-0 top-6 z-10 grid h-9 w-9 place-items-center rounded-2xl bg-[#e5ebdb] text-[#49613d] ring-4 ring-[#f5f2eb]">
                    <Icon className="h-4.5 w-4.5" />
                  </span>

                  <div class="rounded-[28px] bg-white/85 p-5 shadow-sm ring-1 ring-stone-900/5 sm:p-6">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-[#e5ebdb] px-2.5 py-1 text-[11px] font-semibold text-[#49613d]">
                        {commit.type}
                      </span>
                      <div class="flex items-center gap-1.5 text-xs text-stone-400">
                        <GitCommitHorizontal className="h-3.5 w-3.5" />
                        <span>{commit.date}</span>
                      </div>
                    </div>
                    <h3 class="mt-3 break-words text-sm font-semibold leading-6 text-stone-950 sm:text-base">
                      {commit.type}: {commit.title}
                    </h3>
                    <p class="mt-2 text-sm leading-7 text-stone-500">{commit.body}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="grid gap-4 pt-3 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div class="rounded-[28px] bg-white/85 p-6 shadow-sm ring-1 ring-stone-900/5 sm:p-7">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-2xl bg-[#e5ebdb] text-[#49613d]">
              <NotebookPen className="h-5 w-5" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-400">A little note</p>
              <h2 class="mt-1 text-xl font-semibold text-[#183c2f]">写给未来的鱼蛋</h2>
            </div>
          </div>
          <p class="mt-4 text-sm leading-8 text-stone-500">
            如果以后你看到这里，会发现这个网站不是一夜之间做完的。爸爸是一点点把它改出来的：有时候是为了记账更快，有时候是为了文章更好读，这次则是想把你的疫苗和体重好好记下来。工具会继续变，但记录这件事会一直留下来。
          </p>
        </div>

        <div class="rounded-[28px] bg-[#e5ebdb] p-6 shadow-sm ring-1 ring-stone-900/5 sm:p-7">
          <div class="flex items-center gap-2">
            <CheckCircle2 className="h-5 w-5 text-[#49613d]" />
            <h2 class="text-xl font-semibold text-[#24341e]">接下来，慢慢来</h2>
          </div>
          <ul class="mt-4 space-y-2">
            {roadmap.map((item) => (
              <li class="rounded-2xl bg-white/65 px-4 py-3 text-xs leading-6 text-[#49613d]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
